# Copy this file to .env and fill in values. NEVER commit .env.

# "mock" runs offline with a deterministic SIMULATED provider (no API key needed).
# "anthropic" uses the real Claude API.
PROVIDER_MODE=mock

# Required only when PROVIDER_MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: use a different model for the evaluator (more independence)
EVALUATOR_MODEL=

# Number of separate runs a checkpoint must fail in before the system learns a rule for it
LEARNING_THRESHOLD=2

# Folder for SQLite memory files (separate files for mock and real runs)
LESSONGEN_DB_DIR=data
LOG_LEVEL=INFO
